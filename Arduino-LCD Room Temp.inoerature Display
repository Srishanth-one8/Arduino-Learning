// C 
#include <LiquidCrystal.h>
int RS = 8;
int E  = 9;
int D4 = 10;
int D5 = 11;
int D6 = 12;
int D7 = 13;

LiquidCrystal lcd(RS, E, D4, D5, D6, D7);

void setup() {
  lcd.begin(16, 2);
  lcd.setCursor(1, 0);
  lcd.print("ROOM TEMPERATURE:");
  Serial.begin(9600);
}
void loop() {
 int sensor;
 float voltage;
 float temperature;  
 sensor = analogRead(A0);
 voltage = (sensor * 5.0) / 1023.0;
 temperature = (voltage - 0.5) * 100.0;
 lcd.setCursor(0,2);
 lcd.print("Temp: ");
 lcd.print(temperature);
 lcd.print(" C");
 Serial.println(temperature);
 delay(1000);
 }
